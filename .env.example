TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
GEMINI_API_KEY=

# Optional
TELEGRAM_PHONE=
KEEP_DOWNLOADED_VIDEOS=false
VIDEO_COMPRESS_MAX_INPUT_BYTES=209715200

# Optional local Telegram Bot API settings
