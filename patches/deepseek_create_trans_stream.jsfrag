          openThinkingBlock(chunkId);
          if (isSilentModel)
            return;
          const delta = isFoldModel ? { role: "assistant", content: result.v } : { role: "assistant", reasoning_content: result.v };
          writeChunk(chunkId, delta);
          return;
        }
        if (patchPath === "response/content" && typeof result.v === "string") {
          closeThinkingBlock(chunkId);
          writeChunk(chunkId, { role: "assistant", content: result.v.replace(/\[citation:\d+\]/g, "") });
