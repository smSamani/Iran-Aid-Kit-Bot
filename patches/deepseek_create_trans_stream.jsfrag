        if (typeof result.p === "string")
          lastPatchPath = result.p;
        const responseMessageId = result.response_message_id || result.request_message_id || (result.v && result.v.response && result.v.response.message_id) || "patch";
        const chunkId = `${refConvId}@${responseMessageId}`;
