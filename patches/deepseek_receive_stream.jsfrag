          if (!thinking && isThinkingModel && !isSilentModel) {
            thinking = true;
            data.choices[0].message.content += isFoldModel ? "<details><summary>\u601D\u8003\u8FC7\u7A0B</summary><pre>" : "[\u601D\u8003\u5F00\u59CB]\n";
